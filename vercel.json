{
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/morning", "schedule": "0 6 * * *" },
    { "path": "/api/cron/backtest", "schedule": "0 7 * * 1" }
  ]
}
